# Dockerfile for the Simulated Paid API service
FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Only need the packages the simulator actually uses
RUN pip install --no-cache-dir fastapi==0.109.2 uvicorn[standard]==0.27.1 pydantic==2.6.1

COPY simulator/ ./simulator/

EXPOSE 8001

CMD ["uvicorn", "simulator.main:app", "--host", "0.0.0.0", "--port", "8001"]
